# Optional independent GeoAcademic API. Leave unset while the current Supabase
# reads remain active; set this when migrating Lovable/TanStack sections to the open engine.
VITE_GEOACADEMIC_API_URL=https://api.geoacademic.app

# Public Supabase connection values (legacy/current production path during migration)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Never expose these as VITE_* variables.
SUPABASE_SERVICE_ROLE_KEY=replace_me
INGESTION_HOOK_SECRET=replace_with_a_high_entropy_random_secret
ADMIN_BOOTSTRAP_EMAILS=operator@example.com

# Optional persistent ingestion worker for the legacy path
GEOACADEMIC_BASE_URL=https://geoacademic.app
NVIDIA_API_KEY=replace_me

# Optional bounded mode used by GitHub Actions instead of a paid process host.
INGESTION_RUNTIME_MS=45000
INGESTION_BURST_MODE=true
REVIEW_RUNTIME_MS=210000
