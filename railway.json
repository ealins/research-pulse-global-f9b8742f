{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.worker",
    "watchPatterns": [
      "scripts/ingestion-worker.mjs",
      "Dockerfile.worker",
      "railway.json"
    ]
  },
  "deploy": {
    "startCommand": "node scripts/ingestion-worker.mjs",
    "restartPolicyType": "ALWAYS",
    "overlapSeconds": 0,
    "drainingSeconds": 20
  }
}
