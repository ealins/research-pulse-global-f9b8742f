API_DOMAIN=api.geoacademic.app
PUBLIC_CORS_ORIGINS=https://geoacademic.app

POSTGRES_DB=geoacademic
POSTGRES_USER=geoacademic
POSTGRES_PASSWORD=CHANGE_ME_LONG_URL_SAFE_PASSWORD
DB_POOL_MAX=12

# Oracle Object Storage S3-compatible endpoint and customer secret keys.
# Example endpoint shape:
# https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
S3_ENDPOINT=CHANGE_ME
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=geoacademic-evidence
PUBLIC_SNAPSHOT_KEY=public/latest.json
SNAPSHOT_INTERVAL_SECONDS=900

# Shared only with trusted maintenance clients such as GitHub Actions.
INTERNAL_API_TOKEN=CHANGE_ME_HIGH_ENTROPY_TOKEN

WORKER_CONCURRENCY=4
FETCH_TIMEOUT_SECONDS=25
SCHEDULER_INTERVAL_SECONDS=300
SCHEDULER_ENQUEUE_LIMIT=500
TASK_STALE_AFTER_MINUTES=30

# Repeat-check verification promotion.
VERIFY_INTERVAL_SECONDS=600
VERIFY_MIN_AGE_HOURS=6
VERIFY_LIMIT=500
VERIFY_MIN_CONFIDENCE=0.78

# AI is optional. Deterministic/API/JSON-LD extraction runs first.
AI_FALLBACK_ENABLED=true

# Primary ambiguous-page AI route. Set the model explicitly so model choice is never hidden in code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Independent fallback route. Keep backend-only.
NVIDIA_API_KEY=
NVIDIA_MODEL=
