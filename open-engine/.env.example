POSTGRES_DB=geoacademic
POSTGRES_USER=geoacademic
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://geoacademic:change-me@postgres:5432/geoacademic
MINIO_ROOT_USER=geoacademic
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=geoacademic
S3_SECRET_KEY=change-me-too
S3_BUCKET=geoacademic-raw
PUBLIC_CORS_ORIGINS=https://geoacademic.app,http://localhost:3000,http://localhost:5173
WORKER_CONCURRENCY=4
FETCH_TIMEOUT_SECONDS=25
# Optional server-only semantic discovery. Set the key only in a secret store.
EXA_API_KEY=
EXA_DISCOVERY_ENABLED=false
EXA_DISCOVERY_INTERVAL_MINUTES=720
EXA_DISCOVERY_MAX_QUERIES=3
EXA_DISCOVERY_RESULTS_PER_QUERY=8
EXA_DISCOVERY_MAX_CHARACTERS=800
EXA_DISCOVERY_TIMEOUT_SECONDS=20
EXA_DISCOVERY_TYPE=auto
